alias l='eza -F --icons=always'
alias cbcs='colcon build --symlink-install --continue-on-error'
alias stp='. install/setup.bash'
alias bashrc='source ~/.bashrc'
alias code='antigravity-ide-snap.antigravity-ide'
alias clnws='rm -rf build/ install/ log/'
alias ethup='sudo /etc/init.d/ethercat start'
alias ethreup='sudo /etc/init.d/ethercat restart'
alias ethdwn='sudo /etc/init.d/ethercat stop'
alias gitgraph='git log --graph --oneline --all --decorate'
